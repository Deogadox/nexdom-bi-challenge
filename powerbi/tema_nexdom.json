{
  "name": "NEXDOM ANS — identidade visual NEXDOM",
  "dataColors": ["#045F51", "#FF7F40", "#1F1645", "#6CCA98", "#8A8590", "#06262D", "#B8B2BA", "#C45A24"],
  "background": "#FFFFFF",
  "foreground": "#06262D",
  "tableAccent": "#045F51",
  "good": "#045F51",
  "neutral": "#8A8590",
  "bad": "#FF7F40",
  "maximum": "#FF7F40",
  "center": "#E5E1E6",
  "minimum": "#045F51",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#06262D" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#5C5A63" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#06262D" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#06262D" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#ECEAED" } }, "gridlineThickness": 1 }]
      }
    },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#E5E1E6" } }, "transparency": 0 }] } }
